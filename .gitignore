# build artifacts
/dist/
/build/
# operator-local Apple signing config (this repo is public — the account name
# and the plugin root are machine facts, not source)
/config/apple-account
/config/apple.account
/config/apple-home
/config/apple.home
# decrypted secrets (never commit)
*.key
*.minisign.key
*.age.dec
.tmp-*
# TEST signing key (the .pub is committed; the secret key never is)
tools/testkeys/test.key
# operator-run release launcher artifacts (tools/release.command)
.release.log
.release.log.prev
.release.lock/
.release-request

# The `*.key` rule above is a safety net against committing a signing key, and
# it should stay one. This ONE exception is declared here rather than slipped in
# with `git add -f`, so the exception is visible to anyone auditing the rule:
# a TEST-ONLY minisign keypair, generated by `minisign -G -W`, that exists so
# internal/register's parser is tested against a file the real tool produced
# instead of one the parser's own constants synthesised. It signs nothing that
# is trusted anywhere. The release key is age-sealed in release.dp and is never
# in this repo, ignored or not.
!internal/register/testdata/test-only.key
